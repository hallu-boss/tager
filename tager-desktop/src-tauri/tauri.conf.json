{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "tager-desktop",
  "version": "0.1.0",
  "identifier": "com.example.tauri",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "tager-desktop",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "allowAppData": true,
      "allowAppLocalData": true,
      "allowAppCache": true,
      "allowAppLog": true,
      "allowTemp": true,
      "allowDesktop": true,
      "allowDocuments": true,
      "allowDownloads": true,
      "allowMusic": true,
      "allowPictures": true,
      "allowVideos": true,
      "allowHome": true,
      "allowResource": true,
      "allowPublic": true,
      "allowAll": true
    },
    "dialog": {
      "allowOpen": true,
      "allowSave": true,
      "allowMessage": true,
      "allowAsk": true,
      "allowConfirm": true
    }
  }
}
